# Copy to .env (gitignored) on each machine. Never commit real values.

# Claude API key (Computer B). CLAUDE_KEY is accepted as an alias.
ANTHROPIC_API_KEY=

# Shared secret between the audio sender (Computer A) and the engine (Computer B).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
SUBTALK_AUDIO_TOKEN=

# Guest caption viewer relay (Cloudflare Worker). Same value as the Worker secret PUBLISH_TOKEN.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SUBTALK_RELAY_TOKEN=
